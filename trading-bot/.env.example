# MNQ Trading Bot Configuration

# NinjaTrader Connection
NT_HOST=127.0.0.1
NT_PORT=36973
NT_ACCOUNT=Sim101

# Trading Parameters
INSTRUMENT=MNQ 03-24
INITIAL_CAPITAL=10000
DATA_INTERVAL=5m
CHECK_INTERVAL_SECONDS=60

# Strategy (use best from backtest or specify)
STRATEGY_NAME=MA_Crossover
# STRATEGY_PARAMS={"fast_period": 9, "slow_period": 21}

# Risk Management
MAX_POSITION_SIZE=3
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS=500
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=10
MAX_DRAWDOWN_PCT=20.0

# Session Times (Eastern Time)
TRADING_START_HOUR=9
TRADING_START_MINUTE=30
TRADING_END_HOUR=16
TRADING_END_MINUTE=0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# API Server
API_HOST=0.0.0.0
API_PORT=8080

# Docker/Monitoring
GRAFANA_PASSWORD=admin
